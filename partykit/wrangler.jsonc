{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "dpuse-partykit",
    "main": "src/server.ts",
    "compatibility_date": "2026-03-01",
    "durable_objects": {
        "bindings": [
            { "name": "main", "class_name": "DocumentRoom" }
        ]
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["DocumentRoom"] }
    ]
}
