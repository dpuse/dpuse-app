        "node": "^20.19.0 || >=22.12.0"
    },
    "dependencies": {
        "@datapos/datapos-shared": "^0.3.589",
        "@heroicons/vue": "^2.2.0",
        "@tailwindcss/vite": "^4.2.1",
        "@tanstack/ai-client": "^0.5.1",
        "@tanstack/vue-virtual": "^3.13.19",
        "@teamhanko/hanko-frontend-sdk": "^2.4.0",
        "@vueuse/core": "^14.2.1",
        "lucide-vue-next": "^0.575.0",
        "micromark": "^4.0.2",
        "pinia": "^3.0.4",
        "posthog-js": "^1.356.1",
        "quick-lru": "^7.3.0",
        "tailwindcss": "^4.2.1",
        "vue": "^3.5.29",
        "vue-router": "^5.0.3",
        "web-vitals": "^5.1.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.25.6",
        "@cloudflare/workers-types": "^4.20260302.0",
        "@datapos/datapos-development": "^0.3.448",
        "@playwright/test": "^1.58.2",
        "@tsconfig/node24": "^24.0.4",
        "@types/eslint-plugin-security": "^3.0.1",
        "@types/jsdom": "^28.0.0",
        "@types/node": "^25.3.2",
        "@types/trusted-types": "^2.0.7",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@vitejs/plugin-vue": "^6.0.4",
        "@vitest/eslint-plugin": "^1.6.9",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.7.0",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.8.1",
        "eslint": "^9.39.2",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-playwright": "^2.8.0",
        "eslint-plugin-security": "^3.0.1",
        "eslint-plugin-sonarjs": "^3.0.7",
        "eslint-plugin-unicorn": "^62.0.0",
        "eslint-plugin-vue": "~10.8.0",
        "jiti": "^2.6.1",
        "jsdom": "^28.1.0",
        "npm-check-updates": "^19.6.3",
        "npm-run-all2": "^8.0.4",
        "prettier": "3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tw-animate-css": "^1.4.0",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-vue-devtools": "^8.0.6",
        "vitest": "^4.0.18",
        "vue-tsc": "^3.2.5",
        "wrangler": "^4.69.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix --cache",
        "format": "prettier --write --experimental-cli src/",
        "index:knowledge": "op run --env-file=.env -- node ./scripts/indexKnowledge.mjs",
        "test:knowledge": "op run --env-file=.env -- node ./scripts/testKnowledge.mjs",
        "check": "node -e \"import('@datapos/datapos-development').then(m => m.checkDependencies())\"",
        "generate-pwa-assets": "pwa-assets-generator --config pwa.assets.config.ts",
        "release": "npm run build && npm run sync && wrangler deploy",
        "sync": "node -e \"import('@datapos/datapos-development').then(m => m.syncProjectWithGitHub())\""
    }
}