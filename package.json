{
    "name": "dpuse-app",
    "description": "The DPUse browser application.",
    "version": "0.0.1173",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "dependencies": {
        "@dpuse/dpuse-shared": "^0.3.668",
        "@formkit/drag-and-drop": "^0.5.3",
        "@tailwindcss/vite": "^4.3.0",
        "@tanstack/ai-client": "^0.9.1",
        "@tanstack/vue-table": "^8.21.3",
        "@tanstack/vue-virtual": "^3.13.24",
        "@teamhanko/hanko-frontend-sdk": "^2.6.0",
        "lucide-vue-next": "^1.0.0",
        "marked": "^18.0.3",
        "tailwindcss": "^4.3.0",
        "vue": "^3.5.34",
        "vue-router": "^5.0.6",
        "web-vitals": "^5.2.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.36.4",
        "@cloudflare/workers-types": "^4.20260511.1",
        "@dpuse/dpuse-development": "^0.3.500",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
        "@playwright/test": "^1.60.0",
        "@tsconfig/node24": "^24.0.4",
        "@types/eslint-plugin-security": "^3.0.1",
        "@types/eslint-plugin-tailwindcss": "^3.17.0",
        "@types/jsdom": "^28.0.2",
        "@types/node": "^25.7.0",
        "@types/trusted-types": "^2.0.7",
        "@typescript-eslint/eslint-plugin": "^8.59.3",
        "@typescript-eslint/parser": "^8.59.3",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@vitejs/plugin-vue": "^6.0.6",
        "@vitest/eslint-plugin": "^1.6.17",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.7.0",
        "@vue/test-utils": "^2.4.10",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.3.0",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import-x": "^4.16.2",
        "eslint-plugin-playwright": "^2.10.2",
        "eslint-plugin-regexp": "^3.1.0",
        "eslint-plugin-security": "^4.0.0",
        "eslint-plugin-sonarjs": "^4.0.3",
        "eslint-plugin-tailwindcss": "^4.0.0-alpha.2",
        "eslint-plugin-unicorn": "^64.0.0",
        "eslint-plugin-vue": "~10.9.1",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "jiti": "^2.7.0",
        "jsdom": "^29.1.1",
        "npm-check-updates": "^22.2.0",
        "npm-run-all2": "^8.0.4",
        "prettier": "3.8.3",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.3",
        "vite": "^8.0.12",
        "vitest": "^4.1.6",
        "vue-tsc": "^3.2.8",
        "wrangler": "^4.90.1"
    },
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix --cache",
        "format": "prettier --write --experimental-cli src/",
        "index:knowledge": "op run --env-file=.env -- node ./scripts/indexKnowledge.mjs",
        "test:knowledge": "op run --env-file=.env -- node ./scripts/testKnowledge.mjs",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkDependencies())\"",
        "generate-pwa-assets": "pwa-assets-generator --config pwa.assets.config.ts",
        "release": "npm run build && npm run sync && wrangler deploy",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\""
    }
}