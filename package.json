{
    "name": "dpuse-app",
    "description": "The DPUse browser application.",
    "version": "0.0.1392",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "fsevents@2.3.2": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true,
        "workerd@1.20260625.1": true,
        "sharp@0.33.5": true,
        "sharp@0.34.5": true
    },
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" -- && node -e \"import('@dpuse/dpuse-development').then(m => m.documentBundleSizes({ moduleLevel: true }))\"",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix --cache",
        "format": "prettier --write --experimental-cli src/",
        "index:knowledge": "op run --env-file=.env -- node ./scripts/indexKnowledge.mjs",
        "test:knowledge": "op run --env-file=.env -- node ./scripts/testKnowledge.mjs",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkDependencies())\"",
        "generate-pwa-assets": "pwa-assets-generator --config pwa.assets.config.ts",
        "release": "npm run build && npm run sync && wrangler deploy",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "partykitdeploy": "npm install --prefix partykit && npx wrangler deploy --config partykit/wrangler.jsonc"
    },
    "dependencies": {
        "@ai-sdk/vue": "^4.0.4",
        "@dpuse/dpuse-shared": "^0.3.711",
        "@formkit/drag-and-drop": "^0.6.1",
        "@regle/core": "^1.28.1",
        "@regle/rules": "^1.28.1",
        "@tailwindcss/vite": "^4.3.1",
        "@tanstack/ai-client": "^0.19.0",
        "@tanstack/vue-table": "^8.21.3",
        "@tanstack/vue-virtual": "^3.13.30",
        "@teamhanko/hanko-frontend-sdk": "^2.7.0",
        "@tiptap/extension-bold": "^3.27.1",
        "@tiptap/extension-collaboration": "^3.27.1",
        "@tiptap/extension-collaboration-caret": "^3.27.1",
        "@tiptap/extension-document": "^3.27.1",
        "@tiptap/extension-dropcursor": "^3.27.1",
        "@tiptap/extension-gapcursor": "^3.27.1",
        "@tiptap/extension-heading": "^3.27.1",
        "@tiptap/extension-italic": "^3.27.1",
        "@tiptap/extension-paragraph": "^3.27.1",
        "@tiptap/extension-text": "^3.27.1",
        "@tiptap/pm": "^3.27.1",
        "@tiptap/starter-kit": "^3.27.1",
        "@tiptap/vue-3": "^3.27.1",
        "@tiptap/y-tiptap": "^3.0.5",
        "chart.js": "^4.5.1",
        "d3-drag": "^3.0.0",
        "d3-force": "^3.0.0",
        "d3-selection": "^3.0.0",
        "d3-zoom": "^3.0.0",
        "dompurify": "^3.4.11",
        "lucide-vue-next": "^1.0.0",
        "marked": "^18.0.5",
        "tailwindcss": "^4.3.1",
        "vue": "^3.5.39",
        "vue-router": "^5.1.0",
        "web-vitals": "^5.3.0",
        "y-partyserver": "^2.2.0",
        "yjs": "^13.6.31",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.42.3",
        "@cloudflare/workers-types": "^4.20260628.1",
        "@dpuse/dpuse-development": "^0.3.600",
        "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
        "@playwright/test": "^1.61.1",
        "@tsconfig/node24": "^24.0.4",
        "@types/d3-drag": "^3.0.7",
        "@types/d3-force": "^3.0.10",
        "@types/d3-selection": "^3.0.11",
        "@types/d3-zoom": "^3.0.8",
        "@types/eslint-plugin-security": "^3.0.1",
        "@types/eslint-plugin-tailwindcss": "^3.17.0",
        "@types/jsdom": "^28.0.3",
        "@types/node": "^26.0.1",
        "@types/trusted-types": "^2.0.7",
        "@typescript-eslint/eslint-plugin": "^8.62.0",
        "@typescript-eslint/parser": "^8.62.0",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vitest/eslint-plugin": "^1.6.20",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.6.0",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-playwright": "^2.10.4",
        "eslint-plugin-regexp": "^3.1.1",
        "eslint-plugin-security": "^4.0.1",
        "eslint-plugin-sonarjs": "^4.1.0",
        "eslint-plugin-tailwindcss": "^4.0.4",
        "eslint-plugin-unicorn": "^69.0.0",
        "eslint-plugin-vue": "~10.9.2",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "jiti": "^2.7.0",
        "jsdom": "^29.1.1",
        "npm-check-updates": "^22.2.8",
        "npm-run-all2": "^9.0.2",
        "prettier": "3.9.1",
        "rollup-plugin-visualizer": "^7.0.1",
        "sonda": "^0.13.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0",
        "vite": "^8.1.0",
        "vitest": "^4.1.9",
        "vue-tsc": "^3.3.5",
        "wrangler": "^4.105.0"
    }
}