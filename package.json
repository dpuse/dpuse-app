{
    "name": "dpuse-app",
    "version": "0.0.1683",
    "private": true,
    "description": "The DPUse browser application.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-app/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-app.git"
    },
    "type": "module",
    "engines": {
        "node": ">=23.11",
        "npm": ">=11"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "fsevents@2.3.2": true,
        "fsevents@2.3.3": true,
        "maplibre-gl@2.4.0": true,
        "sharp@0.33.5": true,
        "sharp@0.34.5": true,
        "unrs-resolver@1.12.2": true,
        "workerd@1.20260828.1": true
    },
    "scripts": {
        "audit": "node -e \"import('@dpuse/dpuse-development').then(m => m.auditDependencies())\"",
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" -- && node -e \"import('@dpuse/dpuse-development').then(m => m.documentBundleSizes({ moduleLevel: true }))\"",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix --cache",
        "format": "prettier --write --experimental-cli src/",
        "index:knowledge": "op run --env-file=.env -- node ./scripts/indexKnowledge.mjs",
        "test:knowledge": "op run --env-file=.env -- node ./scripts/testKnowledge.mjs",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkConfigFiles())\" && node -e \"import('@dpuse/dpuse-development').then(m => m.checkDependencies())\"",
        "generate-pwa-assets": "pwa-assets-generator --config pwa.assets.config.ts",
        "release": "npm run build && npm run sync && wrangler deploy",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\""
    },
    "dependencies": {
        "@dpuse/dpuse-shared": "^0.3.784",
        "@dpuse/dpuse-tool-d3-visualiser": "^0.0.49",
        "@dpuse/dpuse-tool-marked-markdown-parser": "^0.1.15",
        "@fontsource-variable/inter": "^5.3.0",
        "@formkit/drag-and-drop": "^0.6.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/ai": "^0.52.0",
        "@tanstack/ai-client": "^0.29.2",
        "@tanstack/vue-table": "^9.2.4",
        "@tanstack/vue-virtual": "^3.13.36",
        "@teamhanko/hanko-frontend-sdk": "^3.0.0",
        "dompurify": "^3.4.14",
        "squire-rte": "^2.4.8",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.42",
        "vue-router": "^5.3.0",
        "web-vitals": "^6.2.1"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.54.2",
        "@cloudflare/workers-types": "^5.20260901.1",
        "@dpuse/dpuse-development": "^0.3.706",
        "@dpuse/eslint-config-dpuse": "^1.0.116",
        "@lucide/vue": "^1.38.0",
        "@playwright/test": "^1.62.1",
        "@tsconfig/node24": "^24.0.5",
        "@types/eslint-plugin-tailwindcss": "^3.17.0",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.4.0",
        "@types/trusted-types": "^2.0.7",
        "@types/turndown": "^5.0.6",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.0",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.9.1",
        "eslint-plugin-playwright": "^2.11.0",
        "eslint-plugin-tailwindcss": "^4.4.0",
        "eslint-plugin-vue": "~10.10.0",
        "eslint-plugin-vuejs-accessibility": "^2.6.0",
        "jsdom": "^30.0.1",
        "npm-run-all2": "^9.0.3",
        "prettier": "3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sonda": "^0.14.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.2.2",
        "vitest": "^4.1.11",
        "vue-tsc": "^3.3.11",
        "wrangler": "4.127.1"
    }
}