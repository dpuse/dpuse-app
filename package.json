{
    "name": "dpuse-app",
    "version": "0.0.1874",
    "private": true,
    "description": "The DPUse browser application.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-app/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-app.git"
    },
    "type": "module",
    "engines": {
        "node": ">=24",
        "npm": ">=12"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "error"
        },
        "packageManager": {
            "name": "npm",
            "version": ">=12",
            "onFail": "error"
        }
    },
    "browserslist": [
        "chrome >= 123",
        "edge >= 123",
        "firefox >= 148",
        "safari >= 26",
        "ios_saf >= 26"
    ],
    "allowScripts": {
        "esbuild@0.28.1": true,
        "fsevents": true,
        "unrs-resolver@1.12.2": true,
        "workerd@1.20260921.1": true
    },
    "scripts": {
        "audit": "node -e \"import('@dpuse/dpuse-development').then(m => m.auditDependencies())\"",
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" -- && node -e \"import('@dpuse/dpuse-development').then(m => m.documentBundleSizes({ moduleLevel: true }))\"",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix --cache",
        "lint:app": "eslint . --ignore-pattern 'scripts/**' --ignore-pattern '**/__tests__/**' --fix --cache",
        "format": "prettier --write --experimental-cli src/",
        "index:knowledge": "op run --env-file=.env -- node ./scripts/indexKnowledge.mjs",
        "test:knowledge": "op run --env-file=.env -- node ./scripts/testKnowledge.mjs",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkConfigFiles())\" && node -e \"import('@dpuse/dpuse-development').then(m => m.checkDependencies())\"",
        "generate-pwa-assets": "pwa-assets-generator --config pwa.assets.config.ts",
        "release": "npm run build && npm run sync && wrangler deploy",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\""
    },
    "dependencies": {
        "@dpuse/dpuse-shared": "^0.3.809",
        "@dpuse/dpuse-tool-d3-visualiser": "^0.0.51",
        "@dpuse/dpuse-tool-marked-markdown-parser": "^0.1.15",
        "@fontsource-variable/inter": "^5.3.0",
        "@formkit/drag-and-drop": "^0.6.1",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/ai": "^0.57.0",
        "@tanstack/ai-client": "^0.33.1",
        "@tanstack/vue-table": "^9.2.4",
        "@tanstack/vue-virtual": "^3.13.39",
        "@teamhanko/hanko-frontend-sdk": "^3.0.0",
        "@vueuse/core": "^15.0.0",
        "dompurify": "^3.4.15",
        "squire-rte": "^2.4.9",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.43",
        "vue-router": "^5.3.1",
        "web-vitals": "^6.2.2"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.57.0",
        "@cloudflare/workers-types": "^5.20260921.1",
        "@dpuse/dpuse-development": "^0.3.711",
        "@dpuse/eslint-config-dpuse": "^1.0.116",
        "@lucide/vue": "^1.47.0",
        "@playwright/test": "^1.63.0",
        "@tsconfig/node24": "^24.0.5",
        "@types/eslint-plugin-tailwindcss": "^3.17.0",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.2",
        "@types/trusted-types": "^2.0.7",
        "@types/turndown": "^5.0.6",
        "@vite-pwa/assets-generator": "^2.0.0",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/eslint-plugin": "^1.6.27",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "browserslist-useragent-regexp": "^4.1.4",
        "eslint": "^10.11.0",
        "eslint-plugin-compat": "^7.0.2",
        "eslint-plugin-playwright": "^2.12.0",
        "eslint-plugin-tailwindcss": "^4.4.0",
        "eslint-plugin-vue": "~10.11.0",
        "eslint-plugin-vuejs-accessibility": "^2.6.0",
        "jsdom": "^30.1.0",
        "npm-run-all2": "^9.0.3",
        "prettier": "3.9.8",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sonda": "^0.14.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vitest": "^5.0.1",
        "vue-tsc": "^3.3.11",
        "wrangler": "4.136.0"
    }
}