{
    "name": "dpuse-app",
    "description": "The DPUse browser application.",
    "version": "0.0.746",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "dependencies": {
        "@blockly/theme-modern": "^7.0.5",
        "@dpuse/dpuse-shared": "^0.3.611",
        "@tailwindcss/vite": "^4.2.2",
        "@tanstack/ai-client": "^0.7.8",
        "@tanstack/vue-table": "^8.21.3",
        "@tanstack/vue-virtual": "^3.13.23",
        "@teamhanko/hanko-frontend-sdk": "^2.6.0",
        "blockly": "^12.5.1",
        "lucide-vue-next": "^1.0.0",
        "marked": "^18.0.0",
        "tailwindcss": "^4.2.2",
        "vue": "^3.5.32",
        "vue-router": "^5.0.4",
        "web-vitals": "^5.2.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.31.2",
        "@cloudflare/workers-types": "^4.20260411.1",
        "@dpuse/dpuse-development": "^0.3.489",
        "@playwright/test": "^1.59.1",
        "@tsconfig/node24": "^24.0.4",
        "@types/eslint-plugin-security": "^3.0.1",
        "@types/jsdom": "^28.0.1",
        "@types/node": "^25.6.0",
        "@types/trusted-types": "^2.0.7",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@vitejs/plugin-vue": "^6.0.5",
        "@vitest/eslint-plugin": "^1.6.15",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.7.0",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^9.39.2",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-playwright": "^2.10.1",
        "eslint-plugin-security": "^4.0.0",
        "eslint-plugin-sonarjs": "^4.0.2",
        "eslint-plugin-unicorn": "^63.0.0",
        "eslint-plugin-vue": "~10.8.0",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "jiti": "^2.6.1",
        "jsdom": "^29.0.2",
        "npm-check-updates": "^20.0.1",
        "npm-run-all2": "^8.0.4",
        "prettier": "3.8.2",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tw-animate-css": "^1.4.0",
        "typescript": "~5.9.3",
        "vite": "^8.0.8",
        "vite-plugin-vue-devtools": "^8.1.1",
        "vitest": "^4.1.4",
        "vue-axe": "^3.1.2",
        "vue-tsc": "^3.2.6",
        "wrangler": "^4.81.1"
    },
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix --cache",
        "format": "prettier --write --experimental-cli src/",
        "index:knowledge": "op run --env-file=.env -- node ./scripts/indexKnowledge.mjs",
        "test:knowledge": "op run --env-file=.env -- node ./scripts/testKnowledge.mjs",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkDependencies())\"",
        "generate-pwa-assets": "pwa-assets-generator --config pwa.assets.config.ts",
        "release": "npm run build && npm run sync && wrangler deploy",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\""
    }
}