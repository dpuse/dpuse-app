{
    "name": "datapos-workbench",
    "version": "0.0.28",
    "private": true,
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "dependencies": {
        "@datapos/datapos-shared": "^0.3.530",
        "@tailwindcss/vite": "^4.1.18",
        "@teamhanko/hanko-frontend-sdk": "^2.3.0",
        "@vueuse/core": "^14.1.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-vue-next": "^0.562.0",
        "pinia": "^3.0.4",
        "reka-ui": "^2.7.0",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.18",
        "vue": "^3.5.27",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.21.0",
        "@cloudflare/workers-types": "^4.20260120.0",
        "@datapos/datapos-development": "^0.3.443",
        "@playwright/test": "^1.57.0",
        "@tsconfig/node24": "^24.0.4",
        "@types/eslint-plugin-security": "^3.0.0",
        "@types/jsdom": "^27.0.0",
        "@types/node": "^25.0.9",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@vitejs/plugin-vue": "^6.0.3",
        "@vitest/eslint-plugin": "^1.6.6",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.6.0",
        "@vue/test-utils": "^2.4.6",
        "@vue/tsconfig": "^0.8.1",
        "eslint": "^9.39.2",
        "eslint-plugin-playwright": "^2.5.0",
        "eslint-plugin-vue": "~10.7.0",
        "jiti": "^2.6.1",
        "jsdom": "^27.4.0",
        "npm-check-updates": "^19.3.1",
        "npm-run-all2": "^8.0.4",
        "prettier": "3.8.0",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tw-animate-css": "^1.4.0",
        "typescript": "~5.9.3",
        "vite": "^7.3.1",
        "vite-plugin-vue-devtools": "^8.0.5",
        "vitest": "^4.0.17",
        "vue-tsc": "^3.2.2",
        "wrangler": "^4.59.2"
    },
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix --cache",
        "format": "prettier --write --experimental-cli src/",
        "index:knowledge": "op run --env-file=.env -- node ./scripts/indexKnowledge.mjs",
        "test:knowledge": "op run --env-file=.env -- node ./scripts/testKnowledge.mjs",
        "check": "node -e \"import('@datapos/datapos-development').then(m => m.checkDependencies())\"",
        "generate-pwa-assets": "pwa-assets-generator",
        "release": "npm run build && npm run sync && wrangler deploy",
        "sync": "node -e \"import('@datapos/datapos-development').then(m => m.syncProjectWithGitHub())\""
    }
}