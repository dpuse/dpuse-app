{
    "name": "dpuse-app",
    "version": "0.0.1400",
    "private": true,
    "description": "The DPUse browser application.",
    "license": "MIT",
    "author": "Jonathan Terrell <terrell.jm@gmail.com>",
    "homepage": "https://www.dpuse.app",
    "bugs": {
        "url": "https://github.com/dpuse/dpuse-app/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dpuse/dpuse-app.git"
    },
    "type": "module",
    "engines": {
        "node": ">=22",
        "npm": ">=11"
    },
    "prettier": "@dpuse/dpuse-development/prettierrc",
    "allowScripts": {
        "esbuild@0.28.1": true,
        "fsevents@2.3.2": true,
        "fsevents@2.3.3": true,
        "sharp@0.33.5": true,
        "sharp@0.34.5": true,
        "unrs-resolver@1.12.2": true,
        "workerd@1.20260701.1": true
    },
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" -- && node -e \"import('@dpuse/dpuse-development').then(m => m.documentBundleSizes({ moduleLevel: true }))\"",
        "preview": "vite preview",
        "test:unit": "vitest",
        "test:e2e": "playwright test",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "lint": "eslint . --fix --cache",
        "format": "prettier --write --experimental-cli src/",
        "index:knowledge": "op run --env-file=.env -- node ./scripts/indexKnowledge.mjs",
        "test:knowledge": "op run --env-file=.env -- node ./scripts/testKnowledge.mjs",
        "check": "node -e \"import('@dpuse/dpuse-development').then(m => m.checkConfigFiles())\" && node -e \"import('@dpuse/dpuse-development').then(m => m.checkDependencies())\"",
        "generate-pwa-assets": "pwa-assets-generator --config pwa.assets.config.ts",
        "release": "npm run build && npm run sync && wrangler deploy",
        "sync": "node -e \"import('@dpuse/dpuse-development').then(m => m.syncProjectWithGitHub())\"",
        "partykitdeploy": "npm install --prefix partykit && npx wrangler deploy --config partykit/wrangler.jsonc"
    },
    "dependencies": {
        "@ai-sdk/vue": "^4.0.15",
        "@dpuse/dpuse-shared": "^0.3.729",
        "@formkit/drag-and-drop": "^0.6.1",
        "@regle/core": "^1.28.3",
        "@regle/rules": "^1.28.3",
        "@tailwindcss/vite": "^4.3.2",
        "@tanstack/ai-client": "^0.19.2",
        "@tanstack/vue-table": "^8.21.3",
        "@tanstack/vue-virtual": "^3.13.31",
        "@teamhanko/hanko-frontend-sdk": "^3.0.0",
        "@tiptap/extension-bold": "^3.27.1",
        "@tiptap/extension-collaboration": "^3.27.1",
        "@tiptap/extension-collaboration-caret": "^3.27.1",
        "@tiptap/extension-document": "^3.27.1",
        "@tiptap/extension-dropcursor": "^3.27.1",
        "@tiptap/extension-gapcursor": "^3.27.1",
        "@tiptap/extension-heading": "^3.27.1",
        "@tiptap/extension-italic": "^3.27.1",
        "@tiptap/extension-paragraph": "^3.27.1",
        "@tiptap/extension-text": "^3.27.1",
        "@tiptap/pm": "^3.27.1",
        "@tiptap/vue-3": "^3.27.1",
        "@tiptap/y-tiptap": "^3.0.6",
        "chart.js": "^4.5.1",
        "d3-drag": "^3.0.0",
        "d3-force": "^3.0.0",
        "d3-selection": "^3.0.0",
        "d3-zoom": "^3.0.0",
        "dompurify": "^3.4.11",
        "marked": "^18.0.5",
        "tailwindcss": "^4.3.2",
        "vue": "^3.5.39",
        "vue-router": "^5.1.0",
        "web-vitals": "^5.3.0",
        "y-partyserver": "^2.2.0",
        "yjs": "^13.6.31",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.43.0",
        "@cloudflare/workers-types": "^4.20260702.1",
        "@dpuse/dpuse-development": "^0.3.660",
        "@dpuse/eslint-config-dpuse": "^1.0.104",
        "@lucide/vue": "^1.23.0",
        "@playwright/test": "^1.61.1",
        "@tsconfig/node24": "^24.0.4",
        "@types/d3-drag": "^3.0.7",
        "@types/d3-force": "^3.0.10",
        "@types/d3-selection": "^3.0.11",
        "@types/d3-zoom": "^3.0.8",
        "@types/eslint-plugin-tailwindcss": "^3.17.0",
        "@types/jsdom": "^28.0.3",
        "@types/node": "^26.1.0",
        "@types/trusted-types": "^2.0.7",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vitest/eslint-plugin": "^1.6.21",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "eslint": "^10.6.0",
        "eslint-plugin-playwright": "^2.10.4",
        "eslint-plugin-tailwindcss": "^4.0.6",
        "eslint-plugin-vue": "~10.9.2",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "jsdom": "^29.1.1",
        "npm-run-all2": "^9.0.2",
        "prettier": "3.9.4",
        "sonda": "^0.14.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.1.3",
        "vitest": "^4.1.9",
        "vue-tsc": "^3.3.6",
        "wrangler": "^4.107.0"
    }
}