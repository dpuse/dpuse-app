{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "datapos-workbench",
    "compatibility_date": "2025-09-27", // Cloudflare recommends keeping this within ~30 days of today so you receive current runtime fixes and features for Workers and Durable Objects.
    "main": "server/index.ts",
    "assets": {
        // "binding": "ASSETS",
        "directory": "./dist/client",
        "not_found_handling": "single-page-application"
    },
    "routes": [
        {
            "pattern": "www.datapos.app",
            "zone_name": "datapos.app",
            "custom_domain": true
        }
    ],
    "workers_dev": true,
    "preview_urls": true,
    "placement": {
        "mode": "smart"
    },
    "observability": {
        "enabled": true
    }
}
