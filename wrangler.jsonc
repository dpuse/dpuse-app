{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "datapos-workbench",
    "compatibility_date": "2026-02-01", // Cloudflare recommends keeping this within ~30 days of today so you receive current runtime fixes and features for Workers and Durable Objects.
    "main": "server/index.ts",
    "assets": {
        "binding": "ASSETS",
        "directory": "./dist/client",
        "not_found_handling": "single-page-application",
        "run_worker_first": true // ["/"] // ["/", "!/assets/*", "!/favicon*", "!/manifest*", "!/robots*", "!/pwa*", "!/maskable*", "!/apple*"]
    },
    "observability": {
        "enabled": true
    },
    "routes": [{ "custom_domain": true, "pattern": "www.datapos.app", "zone_name": "datapos.app" }],
    "placement": {
        "mode": "smart"
    },
    "preview_urls": true,
    "workers_dev": true
}
