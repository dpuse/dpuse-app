            {
                "id": "person",
                "label": { "en": "Person" },
                "labelPlural": { "en": "People" },
                "description": {
                    "en": "Each occurrence of this entity represents a single person. A person is said to come into existence when they are born or when another entity chooses to recognise them for some purpose. They will no longer exist if they are deceased or if no entities choose to recognise them. A person may participate in different roles (e.g. acquaintance, colleague, contact, contractor, employee, relation...) at different times. There need only be one occurrence of this entity for each person, no matter how many roles they play across time.\n\nEach occurrence of this entity represents a single person. A person is said to come into existence when they are born or when we chooses to recognise them for informational purposes. They will no longer exist if they are deceased or if we choose not to recognise them. A person may participate in different roles (e.g. acquaintance, colleague, contact, contractor, employee, relation...) at different times. There need only be one occurrence of this entity for each person, no matter how many roles they play across time."
                },
                "characteristics": [
                    { "id": "entId", "label": { "en": "Entity Id" }, "description": { "en": "The unique identifier assigned to the person." } },
                    {
                        "id": "evtMom",
                        "label": { "en": "Event Moment" },
                        "content": "moment",
                        "description": {
                            "en": "The effective moment of the event. See the events for an explanation of how the effective moment is interpreted for each event."
                        }
                    },
                    {
                        "id": "evtSeq",
                        "label": { "en": "Event Sequence" },
                        "content": "number",
                        "description": {
                            "en": "The sequence of the event within the moment. If multiple events occur at the same moment, then we can use this data item to define the sequence."
                        }
                    },
                    {
                        "id": "evtId",
                        "label": { "en": "Event Id" },
                        "description": { "en": "The event identifier. See the events for a list of acceptable identifiers." }
                    },
                    { "id": "perId", "label": { "en": "Personal Id" }, "description": { "en": "The person's personal or national identifier." } },
                    { "id": "famNames", "label": { "en": "Family Names" }, "description": { "en": "The person's family names." } },
                    { "id": "givNames", "label": { "en": "Given Names" }, "description": { "en": "The person's given names." } },
                    { "id": "bthDate", "label": { "en": "Date of Birth" }, "content": "day(first('brn'))" },
                    { "id": "dthDate", "label": { "en": "Date of Death" }, "content": "day(first('dec'))" },
                    { "entityTypeId": "country" },
                    { "entityTypeId": "educationLevel" },
                    { "entityTypeId": "ethnicGroup" },
                    { "entityTypeId": "gender" },
                    { "entityTypeId": "languagePreference" },
                    { "entityTypeId": "location" },
                    { "entityTypeId": "maritalStatus" },
                    { "entityTypeId": "nationality" },
                    { "entityTypeId": "physicalAbility" },
                    { "id": "age", "label": { "en": "Age" }, "content": "ageYears(bthDate)", "lookup": "perAge" },
                    { "id": "ctryBth", "label": { "en": "Country of Birth" }, "lookup": "core.geographic.geoCountry" },
                    { "id": "eduLvl", "label": { "en": "Education Level", "lookup": "perEduLvl" } },
                    { "id": "ethGrp", "label": { "en": "Ethnic Group" }, "lookup": "perEthGrp" },
                    { "id": "gdr", "label": { "en": "Gender" }, "lookup": "perGdr" },
                    { "id": "gen", "label": { "en": "Generation" }, "lookup": "perGen" },
                    { "id": "homeLoc", "label": { "en": "Home Location" }, "lookup": "core.geographic.geoCity" },
                    { "id": "langPref", "label": { "en": "Language (Preferred)" }, "lookup": "perLang" },
                    { "id": "marSts", "label": { "en": "Marital Status" }, "lookup": "perMarSts" },
                    { "id": "min", "label": { "en": "Minority" }, "lookup": "perMin" },
                    { "id": "primNat", "label": { "en": "Primary Nationality" }, "lookup": "perNat" },
                    { "id": "physAb", "label": { "en": "Physical Ability" }, "lookup": "perPhyAb" },
                    { "id": "resLoc", "label": { "en": "Residential Location" }, "lookup": "core.geographic.geoCity" },
                    { "id": "sexOri", "label": { "en": "Sexual Orientation" }, "lookup": "perSexOri" },
                    { "id": "vetSts", "label": { "en": "Veteran Status" }, "lookup": "perVetSts" }
                ],
                "events": {
                    "creation": null,
                    "activation": {
                        "labelAction": "Birth",
                        "labelState": "Born",
                        "description": { "en": "The moment the person was born." }
                    },
                    "recognition": {
                        "labelAction": { "en": "Recognition" },
                        "description": { "en": "The moment the person was recognised for informational purposes." }
                    },

                    "correction": null,
                    "modification": {
                        "id": "modification",
                        "labelAction": { "en": "Modification" },
                        "description": { "en": "The moment associated characteristics took on the specified values. The moment from which the modification applied." }
                    },
                    "derecognition": {
                        "id": "derecognition",
                        "labelAction": { "en": "Derecognition" },
                        "description": {
                            "en": "The moment the person's recognition was revoked for informational purposes. The moment from which the person was no longer recognised."
                        }
                    },
                    "deactivation": {
                        "labelAction": "Death",
                        "labelState": "Deceased",
                        "description": { "en": "The moment the person died. The moment from which the person was no longer alive." }
                    },
                    "archival": null,
                    "deletion": {
                        "labelAction": { "en": "Deletion" },
                        "description": { "en": "The moment the person's details were deleted. The moment from which the person entity was deleted." }
                    }
                },
                "primaryMeasures": {
                    "age": null,
                    "openingCount": {
                        "label": { "en": "Person Opening Count" },
                        "description": { "en": "The number of people present at the opening moment of a reporting period." }
                    },
                    "startingInCount": {
                        "label": { "en": "Person Starting In Count" },
