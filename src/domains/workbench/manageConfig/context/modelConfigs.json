                    },
                    "weightedCount": {
                        "label": { "en": "Person Weighted Count" },
                        "description": { "en": "The weighted number of people present within a reporting period." }
                    },
                    "duringOutCount": {
                        "label": { "en": "Person During Out Count" },
                        "description": { "en": "The number of people derecognised during a reporting period." }
                    },
                    "endingCount": {
                        "label": { "en": "Person Ending Count" },
                        "description": { "en": "The number of people present at the end of a reporting period." }
                    },
                    "endingOutCount": {
                        "label": { "en": "Person Ending Out Count" },
                        "description": { "en": "The number of people derecognised at the last moment of a reporting period." }
                    },
                    "closingCount": {
                        "label": { "en": "Person Closing Count" },
                        "description": { "en": "The number of people present at the closing moment of a reporting period." }
                    }
                }
