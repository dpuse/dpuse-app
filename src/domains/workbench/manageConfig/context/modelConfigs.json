            {
                "id": "organisation",
                "label": { "en": "Organisation" },
                "labelPlural": { "en": "Organisations" },
                "description": {
                    "en": "Each occurrence of this entity represents a single organisation. An organisation is said to come into existence when it is incorporated or when another entity chooses to recognise it for some purpose. It will no longer exist if it is dissolved or if no other entities choose to recognise it.\n\nThere need only be one occurrence of this entity for each organisation no matter how many other entities reference it over time.\n\nAn organisation usually has a type that defines its function or purpose.\n\nIt is not uncommon for there to be formal relationships between organisations. A common example is a global organisation which is comprised of multiple subsidiaries. We may refer to the regional organisations as sections or divisions. However, for the sake of this module, we define each entity independently. Other modules will address the structural relationship between different organisations."
                },
                "characteristics": [{ "id": "name", "label": { "en": "Name" }, "type": "string", "entityTypeId": "organisationType" }],
                "events": {
                    "creation": null,
                    "activation": {
                        "labelAction": { "en": "Incorporation" },
                        "labelState": { "en": "Incorporated" },
                        "description": { "en": "The moment the organisation was incorporated. Optional if there is an incorporation event; otherwise, it is mandatory." }
                    },
                    "recognition": {
                        "labelAction": { "en": "Recognition" },
                        "description": {
                            "en": "The moment the organisation was recognised for informational purposes. Optional if there is an incorporation event; otherwise, it is mandatory."
                        }
                    },
                    "correction": null,
                    "modification": {
                        "labelAction": { "en": "Modification" },
                        "description": { "en": "The moment the organisations characteristics took on the specified values." }
                    },
                    "derecognition": {
                        "labelAction": { "en": "Derecognition" },
                        "description": {
                            "en": "The moment the organisations's recognition was revoked for informational purposes. Optional if there is an dissolution event; otherwise, it is mandatory."
                        }
                    },
                    "deactivation": {
                        "labelAction": { "en": "Dissolution" },
                        "labelState": { "en": "Disolved" },
                        "description": { "en": "The moment the organisation was disolved." }
                    },
                    "archival": null,
                    "deletion": {
                        "labelAction": { "en": "Deletion" },
                        "description": {
                            "en": "The moment the organisations's details were deleted. An occurrence of this event will cause all other events for the organization to be disregarded."
                        }
                    }
                },
                "primaryMeasures": {
                    "age": null,
                    "openingCount": {
                        "label": { "en": "Opening Organisation Count" },
                        "description": {
                            "en": "The number of organisations at the moment the reporting period opened. This count is carried forward from the previous reporting period and is equal to the closing count for that period."
                        },
                        "events": [
                            { "open": "incorporation", "close": "dissolution" },
                            { "open": "recognition", "close": "derecognition" },
                            { "open": { "first": ["incorporation", "recognition"] }, "close": { "last": ["derecognition", "dissolution"] } }
                        ]
                    },
                    "openingGrowth": {
                        "label": { "en": "Opening Organisation Growth" },
                        "description": {
                            "en": "The number of organisations incorporated or recognised the moment the reporting period started. These organisations are not included in the opening count but are included in the starting count."
                        },
                        "events": [{ "first": ["incorporation", "recognition"] }]
                    },

                    "startingInCount": null,
                    "startingCount": {
                        "label": { "en": "Starting Organisation Count" },
                        "description": { "en": "The number of organisations at the moment the reporting period started." }
                    },
                    "interveningGrowth": {
                        "label": { "en": "Intervening Organisation Growth" },
                        "description": {
                            "en": "The number of organisations incorporated or recognised during the reporting period but after the moment the reporting period started."
                        }
                    },
                    "growth": {
                        "label": { "en": "Organisation Growth" },
                        "description": { "en": "The total number of organisations incorporated or recognised during the reporting period." }
                    },
                    "duringInCount": null,
                    "duringCount": {
                        "label": { "en": "During Organisation Count" },
                        "description": {
                            "en": "A count of the number of organisations during the reporting period. In most cases, each organisation will be counted once; however, if it were derecognised and then recognised again within the period, it would be counted twice."
                        }
                    },

                    "weightedCount": {
                        "label": { "en": "Weighted Organisation Count" },
                        "description": {
                            "en": "A weighted count of the number of organisations during the reporting period. If an organisation is active for the entire period, it will be counted as 1; if it is active for half the period, it will be counted as 0.5."
                        }
                    },
                    "decline": {
                        "label": { "en": "Organisation Decline" },
                        "description": { "en": "The total number of organisations dissolved or derecognised during the reporting period." }
                    },
                    "interveningDecline": {
                        "label": { "en": "Intervening Organisation Decline" },
                        "description": {
                            "en": "The number of organisations dissolved or derecognised during the reporting period but before the moment the reporting period ended."
                        }
                    },
                    "duringOutCount": null,
                    "endingCount": {
                        "label": { "en": "Ending Organisation Count" },
                        "description": { "en": "The number of organisations at the moment the reporting period ended." }
                    },
                    "closingDecline": {
                        "label": { "en": "Closing Organisation Decline" },
                        "description": {
                            "en": "The number of organisations dissolved or derecognised the moment the reporting period ended. These organisations are not included in the closing count but are included in the ending count."
                        },
                        "events": [{ "last": ["derecognition", "dissolution"] }]
                    },

                    "endingOutCount": null,
                    "closingCount": {
                        "label": { "en": "Closing Organisation Count" },
                        "description": {
                            "en": "The number of organisations at the moment the reporting period closed. This count is carried forward to the next reporting period and is equal to the opening count for that period."
                        }
                    }
                }
            },
